# Copia in .env (mai versionato) e compila. Nessun valore qui è un segreto reale.

# Obbligatoria. Stringa casuale lunga, per esempio:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# L'app non parte se manca: non esiste un valore di riserva.
SECRET_KEY=

# Password del Postgres di sviluppo (servizio db). Obbligatoria per docker compose.
POSTGRES_PASSWORD=

# Password del Postgres usa e getta per i test (servizio db-test, profilo "test").
TEST_POSTGRES_PASSWORD=

# Porte su 127.0.0.1. Cambiale se sono già occupate sulla tua macchina.
RSTUDY_WEB_PORT=5080
RSTUDY_DB_PORT=55432
RSTUDY_TEST_DB_PORT=55433

# Fiducia negli header X-Forwarded-*: numero di proxy fidati davanti all'app.
# 0 = non fidarsi. In sviluppo restano a 0. In produzione si impostano
# solo dopo aver verificato la catena reale (per esempio Traefik → app = 1).
PROXY_FIX_X_FOR=0
PROXY_FIX_X_PROTO=0
PROXY_FIX_X_HOST=0
