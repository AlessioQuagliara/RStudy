# Copia in .env (mai versionato) e compila. Nessun valore qui è un segreto reale.

# Obbligatoria. Stringa casuale lunga, per esempio:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# L'app non parte se manca: non esiste un valore di riserva.
SECRET_KEY=

# Password del Postgres di sviluppo (servizio db). Obbligatoria per docker compose.
POSTGRES_PASSWORD=

# Password del Postgres usa e getta per i test (compose.test.yaml).
TEST_POSTGRES_PASSWORD=

# Porte su 127.0.0.1. Cambiale se sono già occupate sulla tua macchina.
RSTUDY_WEB_PORT=5080
RSTUDY_DB_PORT=55432
RSTUDY_TEST_DB_PORT=55433

# Fiducia negli header X-Forwarded-*: numero di proxy fidati davanti all'app.
# 0 = non fidarsi. In sviluppo restano a 0. In produzione si impostano
# solo dopo aver verificato la catena reale (per esempio Traefik → app = 1).
PROXY_FIX_X_FOR=0
PROXY_FIX_X_PROTO=0
PROXY_FIX_X_HOST=0

# Generazione AI. Vuoto = disattivata; "fake" = provider simulato (default in sviluppo,
# indicato come tale nell'interfaccia); "openai" = endpoint chat-completions OpenAI-compatibile
# (DeepSeek, Dashscope, OpenAI...), che richiede le tre variabili sotto.
AI_PROVIDER=fake
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Generazioni AI per utente al giorno (si azzera a mezzanotte, ora di Roma).
AI_DAILY_LIMIT=35

# Abbonamenti Paddle Billing. Vuoto = pagamenti disattivati (la prova di 15 giorni scade comunque).
# "sandbox" per i test con le carte di prova, "production" per gli incassi reali: con un valore impostato
# le cinque variabili sotto sono obbligatorie e vanno create nello stesso ambiente Paddle.
PADDLE_ENVIRONMENT=
# Client-side token (Developer tools > Authentication): pubblico per design, finisce nella pagina.
PADDLE_CLIENT_TOKEN=
# API key lato server, solo per aprire il portale clienti. Segreta.
PADDLE_API_KEY=
# Segreto della destinazione webhook (Developer tools > Notifications), URL https://<dominio>/paddle/webhook,
# eventi subscription.*. Segreto.
PADDLE_WEBHOOK_SECRET=
# Prezzi ricorrenti EUR senza trial Paddle: 4,99 al mese e 39,90 all'anno.
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=

# Solo produzione (compose.prod.yaml): dominio pubblico ed email per Let's Encrypt.
DOMAIN=
ACME_EMAIL=
