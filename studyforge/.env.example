# Copia questo file in `.env` (nella stessa cartella) e compila i valori.
# `.env` non viene mai committato (vedi .gitignore) e in produzione viene
# incluso nel pacchetto installabile come extraResource (electron-builder.yml):
# la chiave API Paddle live finisce quindi dentro l'app distribuita agli utenti.
# Usa una API key Paddle con lo scope minimo necessario (sola lettura
# Transactions) dal Dashboard Paddle → Developer Tools → Authentication.

# Chiave API Paddle per l'ambiente Sandbox (test, nessun addebito reale).
PADDLE_API_SANDBOX=

# Chiave API Paddle per l'ambiente Live (addebiti reali). Finché resta vuota,
# l'app usa automaticamente PADDLE_API_SANDBOX.
PADDLE_API=

# Price ID Paddle (Dashboard → Catalog → Prices) del prodotto RStudy.
# Usato dal main process per verificare che la transazione inviata
# dall'utente corrisponda davvero a questo prodotto, non a un acquisto
# qualsiasi effettuato sullo stesso account Paddle.
PADDLE_PRICE_ID=

# --- Provider AI cloud centralizzato (chat/RAG/study pack) ---
# Stesso principio delle chiavi Paddle sopra: pagate e gestite da chi
# distribuisce l'app, mai inserite dall'utente finale in Impostazioni.
# Se non valorizzate, il provider "Cloud" non è disponibile e l'app propone
# il modello locale.
RSTUDY_CLOUD_API_KEY=
RSTUDY_CLOUD_BASE_URL=
RSTUDY_CLOUD_MODEL=

# --- Provider di trascrizione centralizzato (dettato appunti) ---
RSTUDY_TRANSCRIPTION_API_KEY=
RSTUDY_TRANSCRIPTION_BASE_URL=
RSTUDY_TRANSCRIPTION_MODEL=

# Limite giornaliero condiviso di richieste AI cloud per installazione
# (generalista + dettato insieme). Reset a mezzanotte ora italiana
# (Europe/Rome). Se assente o non numerica, il default è 35.
CLOUD_AI_DAILY_USAGE_LIMIT=35

# --- "Genera sessione studio" (PDF multi-agente per corso) ---
# Budget separato dal limite sopra: non consuma le 35 richieste/giorno
# dell'AI generalista. Tetto di chiamate AI per singolo job (anti-loop) e
# intervallo minimo tra una generazione riuscita e la successiva per lo
# stesso corso. Se assenti o non numerici, i default sono 40 e 24.
CLOUD_STUDY_SESSION_MAX_CALLS_PER_JOB=40
CLOUD_STUDY_SESSION_MIN_INTERVAL_HOURS=24
