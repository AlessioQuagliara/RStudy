{
  "name": "rstudy",
  "version": "0.1.0",
  "description": "RStudy — dashboard di studio universitario locale-first (Electron + React)",
  "private": true,
  "author": "Alessio Quagliara",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "tsup --watch --onSuccess \"electron .\"",
    "dev": "concurrently -k -n RENDERER,ELECTRON -c blue,green \"pnpm dev:renderer\" \"wait-on tcp:5173 && pnpm dev:electron\"",
    "build:renderer": "vite build",
    "build:electron": "tsup",
    "build": "pnpm typecheck && pnpm build:renderer && pnpm build:electron",
    "dist:mac": "pnpm build && electron-builder --mac --arm64",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "dist:all": "pnpm build && electron-builder --mac --arm64 --win --linux",
    "release:mac": "pnpm build && electron-builder --mac --arm64 --publish always",
    "release:win": "pnpm build && electron-builder --win --publish always",
    "release:linux": "pnpm build && electron-builder --linux --publish always",
    "release:all": "pnpm build && electron-builder --mac --arm64 --win --linux --publish always",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx electron/db/migrate.ts",
    "seed": "tsx electron/db/seed.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.62.0",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.4",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.4",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.9.0",
    "mermaid": "^11.4.1",
    "monaco-editor": "^0.56.0",
    "node-llama-cpp": "3.21.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "3.25.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "daisyui": "^5.0.0",
    "drizzle-kit": "^0.30.1",
    "electron": "^42.10.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
